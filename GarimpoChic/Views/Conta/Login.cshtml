@{
    ViewData["Title"] = "Login";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/logincli.css" asp-append-version="true">
}

<div class="card">

    <partial name="_LogoCartao" />

    <div class="divisor">
        <div class="divisor-linha"></div>
        <span class="divisor-flor">✿</span>
        <div class="divisor-linha"></div>
    </div>

    @if (ViewData["Erro"] is string erro)
    {
        <div class="alerta-erro">@erro</div>
    }
    @if (TempData["Ok"] is string ok)
    {
        <div class="mensagem-sucesso" style="display:block;margin:0 0 1rem">@ok</div>
    }

    <form action="/" method="post" asp-antiforgery="true">

        <div class="campo">
            <label for="cpf">CPF</label>
            <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" autocomplete="username"
                value="@ViewData["Cpf"]">
            <span class="erro-campo" id="erro-cpf">Informe um CPF válido.</span>
        </div>

        <div class="campo">
            <label for="senha">Senha</label>
            <input type="password" id="senha" name="senha" placeholder="••••••••" autocomplete="current-password">
            <span class="erro-campo" id="erro-senha">Preencha sua senha.</span>
        </div>

        <button type="submit" class="btn-entrar">Entrar</button>

    </form>

    <div class="area-link">
        <p>Ainda não tem conta?</p>
        <a href="/cadastro">Criar minha conta →</a>
    </div>

    <div class="rodape-login">
        <a href="/recuperar-senha">
            Esqueci minha senha
        </a>
        ·
        <a href="/privacidade">Privacidade</a>
    </div>

</div>

@section Scripts {
    <script>
        const form = document.querySelector('form');
        const cpf = document.getElementById('cpf');
        const senha = document.getElementById('senha');

        mascaraCpf(cpf);

        form.addEventListener('submit', e => {
            const okCpf = mostrarErro('erro-cpf', cpfValido(cpf.value));
            const okSenha = mostrarErro('erro-senha', senha.value.trim() !== '');
            if (!okCpf || !okSenha) e.preventDefault();
        });
    </script>
}
