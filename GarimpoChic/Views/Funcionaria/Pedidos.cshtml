@model IEnumerable<object>
@{
    Layout = "_LayoutFuncionaria";
    ViewData["Title"] = "Pedidos";
    ViewData["Menu"] = "pedidos";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/produtos.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pedidos.css" asp-append-version="true">
}

<main class="conteudo">

    <partial name="_TopoPainel" model='("Pedidos", "Acompanhe e atualize os pedidos da loja")' />

    <!-- BUSCA -->

    <div class="barra-prod">
        <div class="busca">
            <input type="search" id="busca" placeholder="Buscar por cliente ou número do pedido..." aria-label="Buscar pedidos por cliente ou número">
        </div>
    </div>

    <!-- FILTROS DE STATUS -->

    <div class="chips">
        <button class="chip ativo" data-status="todos">Todos</button>
        <button class="chip" data-status="preparo">Em preparo</button>
        <button class="chip" data-status="caminho">A caminho</button>
        <button class="chip" data-status="entregue">Entregue</button>
        <button class="chip" data-status="cancelado">Cancelado</button>
    </div>

    <p class="contador" id="contador"></p>

    <!-- TABELA -->

    <div class="painel">

        <div class="tabela-wrap">
            <table class="tabela">
                <thead>
                    <tr>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Data</th>
                        <th>Itens</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th class="col-acoes">Ações</th>
                    </tr>
                </thead>
                <tbody id="corpo"></tbody>
            </table>
        </div>

        <p class="vazio" id="vazio">Nenhum pedido encontrado</p>

    </div>

</main>

<!-- MODAL DE DETALHES -->

<div class="modal-fundo" id="modal">

    <div class="modal">

        <h3 id="det-titulo"></h3>
        <p class="det-sub" id="det-sub"></p>
        <p class="det-sub" id="det-contato"></p>
        <p class="det-sub" id="det-entrega"></p>

        <div id="det-itens"></div>

        <div class="det-total">
            <span>Total</span>
            <strong id="det-total"></strong>
        </div>

        <div class="acoes-modal">
            <button type="button" class="btn-secundario" id="btn-fechar">Fechar</button>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const STATUS = @Json.Serialize(StatusPedido.Nomes);

        let pedidos = @Json.Serialize(Model);

        let filtroStatus = 'todos';

        const corpo = document.getElementById('corpo');
        const busca = document.getElementById('busca');
        const modal = janela('modal', 'btn-fechar');

        function numero(id) {
            return '#' + String(id).padStart(4, '0');
        }

        function total(pedido) {
            return pedido.itens.reduce((soma, i) => soma + i.preco, 0);
        }

        const tabela = tabelaPaginada({
            corpo,
            contador: document.getElementById('contador'),
            vazio: document.getElementById('vazio'),
            singular: 'pedido',
            plural: 'pedidos',
            linha: p => `
                <tr>
                    <td><strong>${numero(p.id)}</strong></td>
                    <td>${esc(p.cliente)}</td>
                    <td>${esc(p.data)}</td>
                    <td>${p.itens.length} ${p.itens.length === 1 ? 'peça' : 'peças'}</td>
                    <td class="preco-cel">${moeda(total(p))}</td>
                    <td>
                        <select class="status-select ${p.status}" data-id="${p.id}" aria-label="Status do pedido ${numero(p.id)}"
                            ${p.status === 'entregue' || p.status === 'cancelado' ? 'disabled' : ''}>
                            ${Object.keys(STATUS).map(s =>
                                `<option value="${s}" ${s === p.status ? 'selected' : ''}>${STATUS[s]}</option>`
                            ).join('')}
                        </select>
                    </td>
                    <td class="col-acoes">
                        <button class="btn-acao" data-id="${p.id}">Ver detalhes</button>
                    </td>
                </tr>
            `,
        });

        function render(opcoes) {
            const texto = busca.value.trim().toLowerCase();

            tabela.mostrar(pedidos.filter(p =>
                (filtroStatus === 'todos' || p.status === filtroStatus) &&
                (p.cliente.toLowerCase().includes(texto) || numero(p.id).includes(texto))
            ), opcoes);
        }

        function abrirDetalhes(pedido) {
            document.getElementById('det-titulo').textContent = 'Pedido ' + numero(pedido.id);
            document.getElementById('det-sub').textContent = pedido.cliente + ' • ' + pedido.data;

            // Contato da cliente: telefone abre o WhatsApp, e-mail abre o programa de e-mail
            const digitos = (pedido.telefone || '').replace(/\D/g, '');
            const contato = [];
            if (digitos.length >= 10)
                contato.push(`<a href="https://wa.me/55${digitos}" target="_blank" rel="noopener">${esc(pedido.telefone)} (WhatsApp)</a>`);
            if (pedido.email)
                contato.push(`<a href="mailto:${esc(pedido.email)}">${esc(pedido.email)}</a>`);
            document.getElementById('det-contato').innerHTML = contato.length ? contato.join(' • ') : 'Sem contato cadastrado';
            document.getElementById('det-entrega').textContent = 'Entrega: ' + pedido.entrega;

            document.getElementById('det-itens').innerHTML = pedido.itens.map(i => `
                <div class="det-item">
                    <span>${esc(i.nome)}</span>
                    <span>${moeda(i.preco)}</span>
                </div>
            `).join('');

            document.getElementById('det-total').textContent = moeda(total(pedido));

            modal.abrir();
        }

        corpo.addEventListener('change', e => {
            const select = e.target.closest('.status-select');
            if (!select) return;

            const pedido = pedidos.find(p => p.id === Number(select.dataset.id));

            const finais = {
                entregue: 'Marcar como entregue? Depois disso o status não muda mais.',
                cancelado: 'Cancelar este pedido? As peças voltam a ficar disponíveis na loja e o status não muda mais.',
            };
            if (finais[select.value] && !confirm(finais[select.value])) {
                render({ manterPosicao: true });
                return;
            }

            postar('/painel/pedidos/' + pedido.id + '/status', { status: select.value })
                .then(() => pedido.status = select.value)
                .catch(falhou)
                .finally(() => render({ manterPosicao: true }));
        });

        corpo.addEventListener('click', e => {
            const btn = e.target.closest('.btn-acao');
            if (!btn) return;

            abrirDetalhes(pedidos.find(p => p.id === Number(btn.dataset.id)));
        });

        chipsDeFiltro('status', status => {
            filtroStatus = status;
            render();
        });

        busca.addEventListener('input', () => render());

        render();
    </script>
}
