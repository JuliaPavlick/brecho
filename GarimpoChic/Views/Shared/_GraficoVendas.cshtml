@model Dictionary<string, Relatorios.Serie>

<script src="~/lib/chartjs/chart.umd.js" asp-append-version="true"></script>

<!-- Bloco do Painel com o Gráfico -->
<div class="painel" style="background: var(--superficie); border-radius: 16px; padding: 24px; border: 1px solid var(--linha);">
    <div class="painel-cabecalho" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <h3 style="font-family: var(--fonte-titulo); color: var(--texto); margin: 0; font-size: 1.9rem; font-weight: 400;">Movimento de <em>vendas</em></h3>
            <p style="font-family: var(--fonte-texto); color: var(--texto-suave); font-size: 0.85rem; margin: 4px 0 0 0;">Acompanhamento do desempenho financeiro</p>
        </div>

        <!-- Filtros de Período -->
        <div class="filtros" style="display: flex; gap: 8px; background: var(--fundo-2); padding: 4px; border-radius: 24px; border: 1px solid var(--linha);">
            <button type="button" class="btn-filtro ativo" data-periodo="semana" aria-pressed="true">Semana</button>
            <button type="button" class="btn-filtro" data-periodo="mes" aria-pressed="false">Mês</button>
            <button type="button" class="btn-filtro" data-periodo="ano" aria-pressed="false">Ano</button>
        </div>
    </div>

    <!-- Contêiner do Gráfico Canvas -->
    <div style="position: relative; height: 320px; width: 100%;">
        <canvas id="graficoRosaChampanhe" role="img" aria-describedby="grafico-resumo"></canvas>
        <!-- O mesmo conteúdo do gráfico, em texto, para leitor de tela -->
        <p id="grafico-resumo" class="sr-only"></p>
    </div>
</div>

<script>
    // Vendas reais por período, calculadas no servidor
    const DADOS_GRAFICO = @Json.Serialize(Model.ToDictionary(s => s.Key, s => new { labels = s.Value.Labels, valores = s.Value.Valores }));

    const ctxGrafico = document.getElementById('graficoRosaChampanhe').getContext('2d');

    // Cores do tema atual (tema.css); o gráfico é redesenhado quando a pessoa troca claro/escuro
    function coresDoGrafico() {
        const acao = corDoTema('--acao');
        const gradiente = ctxGrafico.createLinearGradient(0, 0, 0, 300);
        gradiente.addColorStop(0, acao + '59'); // a cor de ação, translúcida no topo
        gradiente.addColorStop(1, acao + '05');
        return { acao, gradiente, texto: corDoTema('--texto-suave'), linha: corDoTema('--linha'), superficie: corDoTema('--superficie'), fundoDica: corDoTema('--inverso'), textoDica: corDoTema('--inverso-texto') };
    }
    let cores = coresDoGrafico();

    let chartInstancia = new Chart(ctxGrafico, {
        type: 'line',
        data: {
            labels: DADOS_GRAFICO.semana.labels,
            datasets: [{
                label: 'Vendas (R$)',
                data: DADOS_GRAFICO.semana.valores,
                borderColor: cores.acao,
                borderWidth: 3,
                backgroundColor: cores.gradiente,
                fill: true,
                tension: 0.4,                       // Curvatura suave na linha
                pointBackgroundColor: cores.acao,
                pointBorderColor: cores.superficie,
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 8,
                pointHoverBackgroundColor: cores.acao,
                pointHoverBorderColor: cores.superficie
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: cores.fundoDica,
                    titleColor: cores.textoDica,
                    bodyColor: cores.textoDica,
                    titleFont: { family: 'Inter', size: 12 },
                    bodyFont: { family: 'Inter', size: 14, weight: 'bold' },
                    padding: 12,
                    cornerRadius: 10,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return 'R$ ' + context.parsed.y.toLocaleString('pt-BR', { minimumFractionDigits: 2 });
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Inter', size: 12 }, color: cores.texto }
                },
                y: {
                    border: { dash: [4, 4] },
                    grid: { color: cores.linha },
                    ticks: {
                        font: { family: 'Inter', size: 12 },
                        color: cores.texto,
                        callback: function(value) { return 'R$ ' + value; }
                    }
                }
            }
        }
    });

    function descreverGrafico(periodo) {
        const d = DADOS_GRAFICO[periodo];
        document.getElementById('grafico-resumo').textContent = 'Vendas: ' +
            d.labels.map((l, i) => l + ', ' + d.valores[i].toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' })).join('; ') + '.';
    }
    descreverGrafico('semana');

    document.querySelectorAll('.btn-filtro').forEach(btn =>
        btn.addEventListener('click', () => atualizarGrafico(btn.dataset.periodo, btn)));

    function atualizarGrafico(periodo, el) {
        document.querySelectorAll('.btn-filtro').forEach(btn => {
            btn.classList.remove('ativo');
            btn.setAttribute('aria-pressed', 'false');
        });
        el.classList.add('ativo');
        el.setAttribute('aria-pressed', 'true');
        descreverGrafico(periodo);

        chartInstancia.data.labels = DADOS_GRAFICO[periodo].labels;
        chartInstancia.data.datasets[0].data = DADOS_GRAFICO[periodo].valores;
        chartInstancia.update();
    }

    document.addEventListener('tema-mudou', () => {
        cores = coresDoGrafico();
        const serie = chartInstancia.data.datasets[0];
        Object.assign(serie, {
            borderColor: cores.acao, backgroundColor: cores.gradiente, pointBackgroundColor: cores.acao,
            pointBorderColor: cores.superficie, pointHoverBackgroundColor: cores.acao, pointHoverBorderColor: cores.superficie,
        });
        const o = chartInstancia.options;
        Object.assign(o.plugins.tooltip, { backgroundColor: cores.fundoDica, titleColor: cores.textoDica, bodyColor: cores.textoDica });
        o.scales.x.ticks.color = cores.texto;
        o.scales.y.ticks.color = cores.texto;
        o.scales.y.grid.color = cores.linha;
        chartInstancia.update();
    });
</script>
