@{
    var menu = ViewData["Menu"] as string;
    string Ativo(string item) => item == menu ? "ativo" : "";
    var qtdSacola = ViewData["QtdSacola"] as int? ?? 0;
    var funcionaria = User.IsInRole(Papeis.Funcionaria);
    var logado = User.Identity?.IsAuthenticated == true;
    var voltar = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="~/css/dashboard_cliente.css" asp-append-version="true">
    @RenderSection("Estilos", required: false)
</head>

<body>

    <partial name="_Decoracao" />

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div>

            <!-- LOGO -->

            <div class="logo">

                <div class="logo-circulo">
                    <div class="logo-interno">
                        <span class="logo-o">O</span>
                        <span class="logo-garimpo">Garimpo</span>
                        <span class="logo-chic">Chic</span>
                        <span class="logo-brecho">Brechó</span>
                    </div>
                </div>

                <div class="logo-texto">
                    <h1>Garimpo Chic</h1>
                    <p>Garimpado com carinho</p>
                </div>

            </div>

            <!-- MENU -->

            @if (!logado)
            {
                <!-- Visitante: só o catálogo, e os caminhos para entrar ou criar conta -->
                <nav class="menu">
                    <a href="/explorar" class="@Ativo("explorar")">
                        <span class="icone">
                            <img src="~/img/lupa.png" alt="">
                        </span>
                        <span class="texto-menu">Explorar</span>
                    </a>
                    <a href="/?ReturnUrl=@voltar">
                        <span class="icone">
                            <img src="~/img/pessoa.png" alt="">
                        </span>
                        <span class="texto-menu">Entrar</span>
                    </a>
                    <a href="/cadastro?ReturnUrl=@voltar">
                        <span class="icone">
                            <img src="~/img/coracao.png" alt="">
                        </span>
                        <span class="texto-menu">Criar conta</span>
                    </a>
                </nav>
            }
            else
            {
            <nav class="menu">

                <a href="/inicio" class="@Ativo("inicio")">
                    <span class="icone">
                        <img src="~/img/casa.png" alt="">
                    </span>
                    <span class="texto-menu">Início</span>
                </a>

                <a href="/explorar" class="@Ativo("explorar")">
                    <span class="icone">
                        <img src="~/img/lupa.png" alt="">
                    </span>
                    <span class="texto-menu">Explorar</span>
                </a>

                <a href="/favoritos" class="@Ativo("favoritos")">
                    <span class="icone">
                        <img src="~/img/coracao.png" alt="">
                    </span>
                    <span class="texto-menu">Favoritos</span>
                </a>

                <a href="/sacola" class="@Ativo("sacola")">
                    <span class="icone">
                        <img src="~/img/sacolas-de-comprass.png" alt="">
                    </span>
                    <span class="texto-menu">Sacola</span>
                    <span class="contador-sacola" id="qtd-sacola" style="@(qtdSacola == 0 ? "display:none" : "")">@qtdSacola</span>
                </a>

                <a href="/compras" class="@Ativo("compras")">
                    <span class="icone">
                        <img src="~/img/bolsa.png" alt="">
                    </span>
                    <span class="texto-menu">Compras</span>
                </a>

                <a href="/vender" class="@Ativo("vender")">
                    <span class="icone">
                        <img src="~/img/sacola-dinheiro.png" alt="">
                    </span>
                    <span class="texto-menu">Vender</span>
                </a>

                <a href="/perfil" class="@Ativo("perfil")">
                    <span class="icone">
                        <img src="~/img/pessoa.png" alt="">
                    </span>
                    <span class="texto-menu">Perfil</span>
                </a>

            </nav>
            }

        </div>

        <!-- LOGOUT -->

        @if (logado)
        {
        <div class="logout">

            @if (funcionaria)
            {
                <a href="/painel">
                    <span class="icone">
                        <img src="~/img/pranchetas.png" alt="">
                    </span>
                    <span class="texto-menu">Painel</span>
                </a>
            }

            <a href="/sair">
                <span class="icone" aria-hidden="true">↩</span>
                <span class="texto-menu">Sair</span>
            </a>

        </div>
        }

    </aside>

    @RenderBody()

    @RenderSection("Scripts", required: false)

</body>

</html>
