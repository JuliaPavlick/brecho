@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken">
<title>@ViewData["Title"] — Garimpo Chic</title>
<link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
<script src="~/js/site.js" asp-append-version="true"></script>
