@{
    var menu = ViewData["Menu"] as string;
    string Ativo(string item) => item == menu ? "ativo" : "";
    // Diz ao leitor de tela qual item do menu é a página aberta
    string? Atual(string item) => item == menu ? "page" : null;
}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <partial name="_Head" />
    <link rel="stylesheet" href="~/css/dashfunc.css" asp-append-version="true">
    @RenderSection("Estilos", required: false)
</head>

<body>

    <partial name="_Decoracao" />

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-circulo">
                <div class="logo-interno">
                    <span class="logo-o">O</span>
                    <span class="logo-garimpo">Garimpo</span>
                    <span class="logo-chic">Chic</span>
                    <span class="logo-brecho">Brechó</span>
                </div>
            </div>

            <div class="logo-texto">
                <h1>Garimpo Chic</h1>
                <p>Garimpado com carinho</p>
            </div>

        </div>

        <nav class="menu">

            <a href="/painel" class="@Ativo("dashboard")" aria-current="@Atual("dashboard")">
                <span class="icone">
                    <img src="~/img/grafico-preditivo.png" alt="">
                </span>
                <span class="texto">Dashboard</span>
            </a>

            <a href="/painel/produtos" class="@Ativo("produtos")" aria-current="@Atual("produtos")">
                <span class="icone">
                    <img src="~/img/vestido-de-casamento.png" alt="">
                </span>
                <span class="texto">Produtos</span>
            </a>

            <a href="/painel/pedidos" class="@Ativo("pedidos")" aria-current="@Atual("pedidos")">
                <span class="icone">
                    <img src="~/img/caixa.png" alt="">
                </span>
                <span class="texto">Pedidos</span>
            </a>

            <a href="/painel/calendario" class="extra @Ativo("calendario")" aria-current="@Atual("calendario")">
                <span class="icone">
                    <img src="~/img/calendario.png" alt="">
                </span>
                <span class="texto">Calendário</span>
            </a>

            <a href="/painel/financeiro" class="extra @Ativo("financeiro")" aria-current="@Atual("financeiro")">
                <span class="icone">
                    <img src="~/img/grafico-de-crescimento.png" alt="">
                </span>
                <span class="texto">Financeiro</span>
            </a>

            <a href="/painel/clientes" class="extra @Ativo("clientes")" aria-current="@Atual("clientes")">
                <span class="icone">
                    <img src="~/img/pessoas.png" alt="">
                </span>
                <span class="texto">Clientes</span>
            </a>

            <a href="/painel/backup" class="extra @Ativo("backup")" aria-current="@Atual("backup")">
                <span class="icone">
                    <img src="~/img/pranchetas.png" alt="">
                </span>
                <span class="texto">Backup</span>
            </a>

            <a href="/inicio" class="extra">
                <span class="icone">
                    <img src="~/img/sacolas-de-comprass.png" alt="">
                </span>
                <span class="texto">Ver a loja</span>
            </a>

            <!-- Só no celular: abre os itens marcados com "extra" (veja site.js) -->
            <button type="button" class="menu-mais" aria-expanded="false" aria-controls="painel-mais">
                <span class="icone" aria-hidden="true">☰</span>
                <span class="texto">Mais</span>
            </button>

        </nav>

    </aside>

    @RenderBody()

    @RenderSection("Scripts", required: false)

</body>

</html>
