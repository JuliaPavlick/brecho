@model (string Titulo, string Subtitulo)
@{
    var eu = ViewData["Usuario"] as Usuario;
    var voltar = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
}

<div class="topo">
    <div>
        <h2>@Model.Titulo</h2>
        <p>@Model.Subtitulo</p>
    </div>

    @if (eu != null)
    {
        <div class="foto">@eu.Inicial</div>
    }
    else
    {
        <div class="acoes-visitante">
            <a href="/cadastro?ReturnUrl=@voltar" class="botao-topo">Criar conta</a>
            <a href="/?ReturnUrl=@voltar" class="botao-entrar">Entrar</a>
        </div>
    }
</div>
