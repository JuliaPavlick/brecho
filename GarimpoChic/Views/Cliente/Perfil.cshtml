@model Usuario
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Perfil";
    ViewData["Menu"] = "perfil";

    // Depois de um erro, os campos mostram o que a pessoa digitou
    var d = ViewData["Digitado"] as GarimpoChic.Controllers.PerfilForm;

    var papel = Model.EhFuncionaria ? "Funcionária Garimpo Chic"
        : Model.EhVendedora ? "Vendedora Garimpo Chic"
        : "Cliente Garimpo Chic";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true">
}

<main class="conteudo">

    <partial name="_TopoCliente" model='("Meu perfil", "Mantenha seus dados sempre atualizados")' />

    <div class="perfil-grid">

        <!-- RESUMO -->

        <aside class="perfil-resumo">

            <div class="avatar">@Model.Inicial</div>

            <h3>@Model.PrimeiroNome</h3>
            <p class="resumo-sub">@papel</p>

            <div class="resumo-numeros">
                <div>
                    <strong>@ViewData["TotalPedidos"]</strong>
                    <span>Pedidos</span>
                </div>
                <div>
                    <strong>@ViewData["TotalFavoritos"]</strong>
                    <span>Favoritos</span>
                </div>
            </div>

        </aside>

        <!-- FORMULÁRIOS -->

        <div class="perfil-forms">

            <form class="painel-form" id="form-dados" action="/perfil/dados" method="post" asp-antiforgery="true" novalidate>

                <h3>Dados pessoais</h3>

                @if (ViewData["ErroDados"] is string erroDados)
                {
                    <div class="alerta-erro" role="alert">@erroDados</div>
                }

                <div class="linha-campos">
                    <div class="campo">
                        <label for="nome">Nome</label>
                        <input type="text" id="nome" name="nome" maxlength="120" value="@(d != null ? d.Nome : Model.Nome)" autocomplete="name">
                        <span class="erro-campo" id="erro-nome">Informe seu nome.</span>
                    </div>

                    <div class="campo">
                        <label for="cpf">CPF</label>
                        <input type="text" id="cpf" value="@Formato.Cpf(Model.Cpf)" disabled>
                    </div>
                </div>

                <div class="linha-campos">
                    <div class="campo">
                        <label for="email">E-mail</label>
                        <input type="email" id="email" name="email" maxlength="160" value="@(d != null ? d.Email : Model.Email)" data-original="@Model.Email" autocomplete="email">
                        <span class="erro-campo" id="erro-email">Informe um e-mail válido.</span>
                    </div>

                    <div class="campo">
                        <label for="telefone">Telefone</label>
                        <input type="tel" id="telefone" name="telefone" value="@(d != null ? d.Telefone : Model.Telefone)" maxlength="15" inputmode="numeric" autocomplete="tel-national">
                        <span class="erro-campo" id="erro-telefone">Informe um telefone válido.</span>
                    </div>
                </div>

                <div class="linha-campos">
                    <div class="campo">
                        <label for="cidade">Cidade</label>
                        <input type="text" id="cidade" name="cidade" maxlength="80" value="@(d != null ? d.Cidade : Model.Cidade)" autocomplete="address-level2">
                    </div>

                    <div class="campo">
                        <label for="estado">Estado</label>
                        <select id="estado" name="estado" autocomplete="address-level1">
                            <option value="">—</option>
                            @foreach (var uf in Formato.Ufs)
                            {
                                <option value="@uf" selected="@(uf == (d != null ? d.Estado : Model.Estado))">@uf</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="campo" id="campo-senha-email" hidden="@(d == null || string.Equals(d.Email?.Trim(), Model.Email, StringComparison.OrdinalIgnoreCase))">
                    <label for="senha-email">Senha atual (para confirmar a troca de e-mail)</label>
                    <input type="password" id="senha-email" name="senhaEmail" autocomplete="current-password">
                    <span class="erro-campo" id="erro-senha-email">Para trocar o e-mail, informe sua senha atual.</span>
                </div>

                <div class="acoes-form">
                    <span class="msg-sucesso" id="msg-dados" role="status" style="@(TempData["OkDados"] != null ? "display:inline" : "")">Dados salvos</span>
                    <button type="submit" class="btn-salvar">Salvar alterações</button>
                </div>

            </form>

            <form class="painel-form" id="form-senha" action="/perfil/senha" method="post" asp-antiforgery="true" novalidate>

                <h3>Alterar senha</h3>

                @if (TempData["ErroSenha"] is string erroSenha)
                {
                    <div class="alerta-erro">@erroSenha</div>
                }

                <div class="campo">
                    <label for="senha-atual">Senha atual</label>
                    <input type="password" id="senha-atual" name="atual" autocomplete="current-password">
                    <span class="erro-campo" id="erro-senha-atual">Informe sua senha atual.</span>
                </div>

                <div class="linha-campos">
                    <div class="campo">
                        <label for="senha-nova">Nova senha</label>
                        <input type="password" id="senha-nova" name="nova" autocomplete="new-password">
                        <span class="erro-campo" id="erro-senha-nova">Use pelo menos 8 caracteres.</span>
                    </div>

                    <div class="campo">
                        <label for="senha-confirma">Confirmar nova senha</label>
                        <input type="password" id="senha-confirma" autocomplete="new-password">
                        <span class="erro-campo" id="erro-senha-confirma">As senhas não coincidem.</span>
                    </div>
                </div>

                <div class="acoes-form">
                    <span class="msg-sucesso" id="msg-senha" role="status" style="@(TempData["OkSenha"] != null ? "display:inline" : "")">Senha alterada</span>
                    <button type="submit" class="btn-salvar">Alterar senha</button>
                </div>

            </form>

            <section class="painel-form perfil-privacidade" id="excluir">

                <h3>Privacidade e seus dados</h3>

                <p>
                    Baixe uma cópia de tudo o que a loja guarda sobre você ou exclua a sua conta.
                    Veja os detalhes na <a href="/privacidade" class="link-privacidade">Política de Privacidade</a>.
                </p>

                <div class="acoes-privacidade">
                    <a href="/perfil/meus-dados" class="btn-contorno">Baixar meus dados</a>
                </div>

                @if (TempData["ErroExcluir"] is string erroExcluir)
                {
                    <div class="alerta-erro">@erroExcluir</div>
                }

                <form action="/perfil/excluir" method="post" asp-antiforgery="true"
                    data-confirmar="Excluir sua conta? Seu nome, CPF, e-mail e telefone serão apagados e não dá para desfazer.">
                    <div class="campo">
                        <label for="senha-excluir">Para excluir a conta, confirme sua senha</label>
                        <input type="password" id="senha-excluir" name="senha" autocomplete="current-password" required>
                    </div>
                    <div class="acoes-form">
                        <button type="submit" class="btn-excluir">Excluir minha conta</button>
                    </div>
                </form>

            </section>

        </div>

    </div>

</main>

@section Scripts {
    <script>
        const telefone = document.getElementById('telefone');

        mascaraTelefone(telefone);

        // O campo de senha só aparece quando o e-mail muda
        const campoEmail = document.getElementById('email');
        campoEmail.addEventListener('input', () => {
            document.getElementById('campo-senha-email').hidden =
                campoEmail.value.trim().toLowerCase() === campoEmail.dataset.original.toLowerCase();
        });

        document.getElementById('form-dados').addEventListener('submit', e => {
            const okNome = mostrarErro('erro-nome', document.getElementById('nome').value.trim() !== '');
            const okEmail = mostrarErro('erro-email', /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(document.getElementById('email').value));
            const okTel = mostrarErro('erro-telefone', telefone.value.replace(/\D/g, '').length >= 10);
            const trocouEmail = !document.getElementById('campo-senha-email').hidden;
            const okSenha = mostrarErro('erro-senha-email', !trocouEmail || document.getElementById('senha-email').value !== '');

            if (!okNome || !okEmail || !okTel || !okSenha) e.preventDefault();
        });

        document.getElementById('form-senha').addEventListener('submit', e => {
            const atual = document.getElementById('senha-atual').value;
            const nova = document.getElementById('senha-nova').value;
            const confirma = document.getElementById('senha-confirma').value;

            const okAtual = mostrarErro('erro-senha-atual', atual !== '');
            const okNova = mostrarErro('erro-senha-nova', nova.length >= 8);
            const okConfirma = mostrarErro('erro-senha-confirma', nova === confirma && confirma !== '');

            if (!okAtual || !okNova || !okConfirma) e.preventDefault();
        });
    </script>
}
