@model ExplorarPagina
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Explorar";
    ViewData["Menu"] = "explorar";

    // Monta o endereço mantendo a busca e a ordem atuais
    string Link(string? categoria = null, int pagina = 1)
    {
        var partes = new List<string>();
        if (Model.Busca != "") partes.Add("q=" + Uri.EscapeDataString(Model.Busca));
        var cat = categoria ?? Model.Categoria;
        if (cat != "todos") partes.Add("categoria=" + cat);
        if (Model.Ordem != "relevancia") partes.Add("ordem=" + Model.Ordem);
        if (pagina > 1) partes.Add("pagina=" + pagina);
        return "/explorar" + (partes.Count > 0 ? "?" + string.Join("&", partes) : "");
    }
}

@section Estilos {
    <link rel="stylesheet" href="~/css/explorar.css" asp-append-version="true">
}

<!-- CONTEÚDO -->

<main class="conteudo">

    <partial name="_TopoCliente" model='("Explorar", "Encontre sua próxima peça favorita")' />

    <!-- BUSCA + ORDENAR -->

    <form class="explorar-barra" action="/explorar" method="get" role="search" id="form-busca">

        <div class="busca">
            <span class="busca-icone" aria-hidden="true">🔎</span>
            <input type="search" id="busca" name="q" value="@Model.Busca" placeholder="Buscar por nome da peça..."
                aria-label="Buscar por nome da peça" enterkeyhint="search">
        </div>

        @if (Model.Categoria != "todos")
        {
            <input type="hidden" name="categoria" value="@Model.Categoria">
        }

        <select id="ordenar" name="ordem" class="ordenar" aria-label="Ordenar peças">
            <option value="relevancia" selected="@(Model.Ordem == "relevancia")">Mais recentes</option>
            <option value="menor" selected="@(Model.Ordem == "menor")">Menor preço</option>
            <option value="maior" selected="@(Model.Ordem == "maior")">Maior preço</option>
        </select>

    </form>

    <!-- CATEGORIAS -->

    <nav class="chips" aria-label="Categorias">
        <a class="chip @(Model.Categoria == "todos" ? "ativo" : "")" href="@Link("todos")">Todos</a>
        @foreach (var c in Categorias.Todas)
        {
            <a class="chip @(Model.Categoria == c.Slug ? "ativo" : "")" href="@Link(c.Slug)">@c.Nome</a>
        }
    </nav>

    <p class="contador">
        @Model.Total @(Model.Total == 1 ? "peça encontrada" : "peças encontradas")
        @if (Model.Busca != "")
        {
            <text>para “@Model.Busca” · <a href="@("/explorar" + (Model.Categoria != "todos" ? "?categoria=" + Model.Categoria : ""))">limpar busca</a></text>
        }
    </p>

    <!-- PRODUTOS -->

    @if (Model.Pecas.Count == 0)
    {
        <p class="vazio" style="display:block">Nenhuma peça encontrada ✦</p>
    }
    else
    {
        <div class="produtos" id="lista">
            @foreach (var p in Model.Pecas)
            {
                <partial name="_ProdutoCard" model="p" />
            }
        </div>
    }

    @if (Model.Paginas > 1)
    {
        <nav class="paginacao" aria-label="Páginas">
            @if (Model.Pagina > 1)
            {
                <a href="@Link(pagina: Model.Pagina - 1)" rel="prev">← Anterior</a>
            }
            <span>Página @Model.Pagina de @Model.Paginas</span>
            @if (Model.Pagina < Model.Paginas)
            {
                <a href="@Link(pagina: Model.Pagina + 1)" rel="next">Próxima →</a>
            }
        </nav>
    }

</main>

@section Scripts {
    <script>
        // Mudar a ordem já refaz a busca
        document.getElementById('ordenar').addEventListener('change', () =>
            document.getElementById('form-busca').submit());

        document.querySelectorAll('button.favorito').forEach(btn => {
            btn.addEventListener('click', () => alternarFavorito(btn).catch(falhou));
        });
    </script>
}
