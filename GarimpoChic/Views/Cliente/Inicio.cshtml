@model List<ProdutoCard>
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Início";
    ViewData["Menu"] = "inicio";
    var eu = (Usuario)ViewData["Usuario"]!;
    // A peça mais nova com foto vira o destaque do topo
    var destaque = Model.FirstOrDefault(p => p.FotoId != null);
}

<!-- CONTEÚDO -->

<main class="conteudo">

    <!-- TOPO -->

    <div class="topo">

        <div>

            <h2>Olá, <em>@eu.PrimeiroNome</em></h2>

            <p>
                Que bom ter você no Garimpo Chic
            </p>

        </div>

        <div class="acoes-topo">

            <partial name="_BotaoTema" />

            <a href="/explorar" class="botao-topo">
                Novidades
            </a>

            <div class="foto">
                @eu.Inicial
            </div>

        </div>

    </div>

    <!-- HERO -->

    <section class="hero">

        <div class="hero-texto">

            <span>NOVA COLEÇÃO</span>

            <h1>
                Peças únicas, <em>escolhidas com carinho</em>
            </h1>

            <p>
                Descubra novas peças vintage, elegantes e exclusivas disponíveis no brechó.
            </p>

            <a href="/explorar" class="botao-hero">
                Explorar agora
            </a>

        </div>

        @if (destaque != null)
        {
            <a href="/peca/@destaque.Id" class="hero-imagem hero-moldura" aria-label="Ver @destaque.Nome">
                <img src="/fotos/@destaque.FotoId" alt="">
            </a>
        }

    </section>

    <!-- PRODUTOS -->

    <section class="secao">

        <div class="secao-topo">

            <h3>Peças para você</h3>

            <a href="/explorar">
                Ver tudo
            </a>

        </div>

        <div class="produtos">

            @foreach (var p in Model)
            {
                <partial name="_ProdutoCard" model="p" />
            }

        </div>

        @if (Model.Count == 0)
        {
            <p>Nenhuma peça disponível no momento</p>
        }

    </section>

</main>

@section Scripts {
    <script>
        document.querySelectorAll('.favorito').forEach(btn => {
            btn.addEventListener('click', () => alternarFavorito(btn).catch(falhou));
        });
    </script>
}
