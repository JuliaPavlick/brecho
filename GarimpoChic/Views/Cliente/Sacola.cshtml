@model List<ProdutoCard>
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Sacola";
    ViewData["Menu"] = "sacola";

    var disponiveis = Model.Where(p => p.Disponivel).ToList();
    var total = disponiveis.Sum(p => p.Preco);
}

@section Estilos {
    <link rel="stylesheet" href="~/css/explorar.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/compras.css" asp-append-version="true">
}

<main class="conteudo">

    <partial name="_TopoCliente" model='("Minha sacola", "Confira as peças antes de finalizar a compra")' />

    @if (TempData["Erro"] is string erro)
    {
        <div class="alerta-erro">@erro</div>
    }

    @if (Model.Count == 0)
    {
        <p class="vazio" style="display:block">Sua sacola está vazia ✦ <a href="/explorar">Explorar peças</a></p>
    }
    else
    {
        <div class="pedidos">

            <div class="pedido">

                <div class="pedido-topo">
                    <div>
                        <h4>@Model.Count @(Model.Count == 1 ? "peça" : "peças")</h4>
                        <p>Cada peça é única: ela fica reservada para você só depois de finalizar.</p>
                    </div>
                </div>

                <div class="pedido-itens">
                    @foreach (var p in Model)
                    {
                        <div class="item" style="@(p.Disponivel ? "" : "opacity:0.55")">
                            <div class="item-img">
                                @if (p.FotoId != null)
                                {
                                    <img src="/fotos/@p.FotoId" alt="@p.Nome">
                                }
                                else
                                {
                                    @p.Emoji
                                }
                            </div>
                            <div class="item-info">
                                <h5>@p.Nome</h5>
                                <p>@(p.Disponivel ? p.Descricao : "Esta peça não está mais disponível")</p>
                            </div>
                            <span class="item-preco">@Formato.Moeda(p.Preco)</span>
                            <form action="/sacola/@p.Id/remover" method="post" asp-antiforgery="true">
                                <button type="submit" class="btn-remover" title="Tirar da sacola">✕</button>
                            </form>
                        </div>
                    }
                </div>

                <div class="pedido-rodape">
                    <span>Total</span>
                    <strong>@Formato.Moeda(total)</strong>
                </div>

            </div>

        </div>

        @if (disponiveis.Count > 0)
        {
            <form action="/sacola/finalizar" method="post" asp-antiforgery="true" class="finalizar"
                onsubmit="return confirm('Finalizar a compra de @disponiveis.Count @(disponiveis.Count == 1 ? "peça" : "peças") por @Formato.Moeda(total)?')">
                <p>Ao finalizar, a loja recebe o seu pedido e entra em contato para combinar o pagamento e a entrega.</p>
                <button type="submit" class="btn-sacola ativo">Finalizar compra</button>
            </form>
        }
    }

</main>
