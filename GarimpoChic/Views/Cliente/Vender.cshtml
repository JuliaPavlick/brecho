@model List<Produto>
@{
    Layout = "_LayoutCliente";
    ViewData["Title"] = "Vender para a loja";
    ViewData["Menu"] = "vender";
}

@section Estilos {
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/compras.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/vender.css" asp-append-version="true">
}

<main class="conteudo">

    <partial name="_TopoCliente" model='("Quero vender para a loja", "Envie suas peças para avaliação da nossa equipe")' />

    <div class="vender-grid">

        <!-- ENVIAR PEÇA -->

        <form class="painel-form" id="form-peca" action="/vender" method="post" asp-antiforgery="true" enctype="multipart/form-data" novalidate>

            <h3>Enviar uma peça</h3>

            @if (TempData["Erro"] is string erro)
            {
                <div class="alerta-erro">@erro</div>
            }
            @if (TempData["Ok"] != null)
            {
                <div class="alerta-ok">Peça enviada! Ela aparece abaixo como "Em avaliação" até a loja revisar ✦</div>
            }

            <div class="campo">
                <label for="nome">Nome da peça</label>
                <input type="text" id="nome" name="nome" placeholder="Ex.: Vestido longo de linho">
                <span class="erro-campo" id="erro-nome">Informe o nome da peça.</span>
            </div>

            <div class="campo">
                <label for="descricao">Descrição</label>
                <textarea id="descricao" name="descricao" rows="3" placeholder="Tamanho, estado de conservação, detalhes..."></textarea>
            </div>

            <div class="linha-campos">
                <div class="campo">
                    <label for="categoria">Categoria</label>
                    <select id="categoria" name="categoria">
                        @foreach (var c in Categorias.Todas)
                        {
                            <option>@c.Nome</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label for="preco">Preço sugerido (R$)</label>
                    <input type="number" id="preco" name="preco" step="0.01" min="0" placeholder="0,00">
                    <span class="erro-campo" id="erro-preco">Informe um preço maior que zero.</span>
                </div>
            </div>

            <div class="campo">
                <label for="fotos">Fotos (JPG, PNG ou WebP; até 5). Fotos grandes são reduzidas sozinhas antes do envio.</label>
                <input type="file" id="fotos" name="fotos" accept="image/jpeg,image/png,image/webp" multiple data-reduzir>
            </div>

            <div class="acoes-form">
                <button type="submit" class="btn-salvar">Enviar para avaliação</button>
            </div>

        </form>

        <!-- MINHAS PEÇAS -->

        <div class="painel-form">

            <h3>Minhas peças enviadas</h3>

            @if (Model.Count == 0)
            {
                <p class="sem-pecas">Você ainda não enviou nenhuma peça ✦</p>
            }

            @foreach (var p in Model)
            {
                <div class="item">
                    <div class="item-img">@p.Emoji</div>
                    <div class="item-info">
                        <h5>@p.Nome</h5>
                        <p>@Formato.Moeda(p.Preco)</p>
                    </div>
                    <span class="badge @p.Status">@StatusProduto.Nomes.GetValueOrDefault(p.Status)</span>
                </div>
            }

        </div>

    </div>

</main>

@section Scripts {
    <script>
        document.getElementById('form-peca').addEventListener('submit', e => {
            const okNome = mostrarErro('erro-nome', document.getElementById('nome').value.trim() !== '');
            const okPreco = mostrarErro('erro-preco', parseFloat(document.getElementById('preco').value) > 0);
            if (!okNome || !okPreco) e.preventDefault();
        });
    </script>
}
